    public class Game1 : Game
    {
        private GraphicsDeviceManager _graphics;
        private SpriteBatch _spriteBatch;
        List<Ball> balls;
        SpriteFont _font;
        bool StartingCursorOnBall;
        bool CursorOnBall = false;
        public SoundEffect ImpactSound;
        Rectangle box, pauseRect, pause, play, xy, graph, save, open, saveRect, openRect;
        Texture2D _box, _pause, _play, _xy, _graph, _save, _open;
        bool Collision = true;
        bool Dragging = false;
