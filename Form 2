using static System.Windows.Forms.VisualStyles.VisualStyleElement;

namespace Physics_Simulator
{
    public partial class Form1 : Form
    {
        private Ball ball;
        public Form1(Ball ballToEdit)
        {
            InitializeComponent();
            ball = ballToEdit;
            PosXBox.Text = $"{ball.position.X:F0}";
            PosYBox.Text = $"{ball.position.Y:F0}";
            VertVelBox.Text = $"{ball.velocity.Y:F2}";
            HorVelBox.Text = $"{ball.velocity.X:F2}";
            MassBox.Text = ball.m.ToString();
            eBox.Text = ball.restitution.ToString();
            RadBox.Text = ball.r.ToString();
            FrictionBox.Text = ball.friction.ToString();
            this.AcceptButton = OkButton;
        }
        private void Form1_Load(object sender, EventArgs e)
        {
        }
        protected override void OnShown(EventArgs e)
        {
            base.OnShown(e);
            HorVelBox.Focus();
            HorVelBox.SelectAll();
        }
        private void VertVelBox_TextChanged(object sender, EventArgs e)
        {

        }

        private void eBox_TextChanged(object sender, EventArgs e)
        {

        }

        private void OkButton_Click(object sender, EventArgs e)
        {
            float prevRad = ball.r;
            float prevY = ball.velocity.Y;
            if (float.TryParse(MassBox.Text, out float newMass))
                ball.m = Math.Clamp(newMass, 0.1f, 10000f);

            if (float.TryParse(RadBox.Text, out float newRadius))
                ball.r = Math.Clamp(newRadius, 1f, 200f);

            if (float.TryParse(eBox.Text, out float newRest))
                ball.restitution = Math.Clamp(newRest, 0f, 1f);

            if (float.TryParse(VertVelBox.Text, out float j))
                ball.velocity.Y = j;

            if (float.TryParse(HorVelBox.Text, out float i))
                ball.velocity.X = i;

            if (float.TryParse(PosXBox.Text, out float x))
                ball.position.X = x;

            if (float.TryParse(PosYBox.Text, out float y))
                ball.position.Y = y;

            if (float.TryParse(FrictionBox.Text, out float f))
                ball.friction = Math.Clamp(f, 0f, 1f);

            ball.position.X += (prevRad - ball.r);
            ball.position.Y += (prevRad - ball.r);

            DialogResult = DialogResult.OK;
            Close();
        }

        private void label1_Click(object sender, EventArgs e)
        {

